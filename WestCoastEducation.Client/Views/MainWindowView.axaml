<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WestCoastEducation.Client.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducation.Client.Views.MainWindowView"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WestCoastEducationClient">

    <Grid ColumnDefinitions="200, *">

        <Border Classes="menuContainer">
            
        <StackPanel Grid.Column="0">
            <TextBlock Text="Westcoast Education"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"
                       Foreground="{DynamicResource TextPrimary}" />

            <Button 
                HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="5,2"
                    Command="{Binding NavigateToTeachersPageCommand}">
                <TextBlock Text="Teachers" />
            </Button>

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="5,2"
                    Command="{Binding NavigateToStudentsPageCommand}">
                <TextBlock Text="Students" />
            </Button>

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="5,2"
                    Command="{Binding NavigateToCoursesPageCommand}">
                <TextBlock Text="Courses" />
            </Button>
        </StackPanel>
        </Border>
        

        <!-- Page host -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>