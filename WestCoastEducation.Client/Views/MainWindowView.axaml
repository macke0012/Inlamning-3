<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WestCoastEducation.Client.ViewModels"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducation.Client.Views.MainWindowView"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding CurrentPage.PageTitle}">

    <Grid ColumnDefinitions="250, *" RowDefinitions="*, Auto">

        <Border Grid.RowSpan="2" Classes="menuContainer">

            <Grid RowDefinitions="*, Auto">
                <StackPanel>
                    <TextBlock Text="Westcoast Education"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"
                               Foreground="{DynamicResource TextPrimary}" />

                    <Button Classes="menuButton"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToTeachersPageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <avalonia:MaterialIcon Kind="Teacher"  />
                            <TextBlock Text="Lärare"></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button
                        Classes="menuButton"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NavigateToStudentsPageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <avalonia:MaterialIcon Kind="AccountStudent"  />
                            <TextBlock Text="Elever"></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button
                        Classes="menuButton"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NavigateToCoursesPageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <avalonia:MaterialIcon Kind="GoogleClassroom"  />
                            <TextBlock Text="Kurser"></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                    <Button Grid.Row="1" Classes="menuButton"
                            Margin="10,10"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <avalonia:MaterialIcon Kind="Home"  />
                            <TextBlock Text="Hem"></TextBlock>
                        </StackPanel>
                    </Button>
                
            </Grid>
        </Border>
        <!-- Page host -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>