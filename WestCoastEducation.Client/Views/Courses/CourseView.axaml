<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WestCoastEducation.Client.ViewModels"
             xmlns:courses="clr-namespace:WestCoastEducation.Client.ViewModels.Courses"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="courses:CourseViewModel"
             x:Class="WestCoastEducation.Client.Views.Courses.CourseView">
    <Grid RowDefinitions="Auto, *">
        <StackPanel>
            <Button Content="Skapa Kurs"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToAddCourseCommand}" />
        </StackPanel>
        <TableView Grid.Row="1" ItemsSource="{Binding Courses}" 
                   SelectedItem="{Binding SelectedCourse}">
            <TableView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" Command="{Binding DeleteCourseCommand}" CommandParameter="{Binding SelectedCourse}"></MenuItem>
                    <MenuItem Header="Edit" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToEditStudentCommand}" CommandParameter="{Binding SelectedCourse}" ></MenuItem>
                </ContextMenu>
            </TableView.ContextMenu>
            <TableView.Columns>
                <TableViewColumn Header="Kursnummer" Binding="{Binding CourseNumber}"></TableViewColumn>
                <TableViewColumn Header="Title" Binding="{Binding Title}"></TableViewColumn>
                <TableViewColumn Header="Startdatum" Binding="{Binding StartDate}"></TableViewColumn>
                <TableViewColumn Header="Slutdatum" Binding="{Binding EndDate}"></TableViewColumn>
                <TableViewColumn Header="Kurstyp" Binding="{Binding CourseType }"></TableViewColumn>
            </TableView.Columns>
        </TableView>
    </Grid>
</UserControl>
