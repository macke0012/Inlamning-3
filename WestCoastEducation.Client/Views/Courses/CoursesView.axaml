<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WestCoastEducation.Client.ViewModels"
             xmlns:courses="clr-namespace:WestCoastEducation.Client.ViewModels.Courses"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="courses:CoursesViewModel"
             x:Class="WestCoastEducation.Client.Views.Courses.CoursesView">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="5">
            <Button
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToAddCourseCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <avalonia:MaterialIcon Kind="ArchiveAdd" />
                    <TextBlock Text="Skapa kurs"></TextBlock>
                </StackPanel>
            </Button>
            <Button  Command="{Binding GenerateCoursesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <avalonia:MaterialIcon Kind="Magic" />
                    <TextBlock Text="Generera 5 kurser"></TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        <TableView Grid.Row="1"
                   SelectionMode="Multiple"
                   ItemsSource="{Binding Courses}" 
                   SelectedItems="{Binding SelectedCourses}">
            <TableView.ContextMenu>
                <ContextMenu>
                    <MenuItem IsEnabled="{Binding IsEditable}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToEditCourseCommand}" CommandParameter="{Binding SelectedCourses[0]}" >
                        <MenuItem.Icon>
                            <avalonia:MaterialIcon Kind="ArchiveEdit"></avalonia:MaterialIcon>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Text="Redigera"></TextBlock>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem   Command="{Binding SetShowPopUpCommand}" CommandParameter="Är du säker på att du vill radera de valda kurserna?">
                        <MenuItem.Icon>
                            <avalonia:MaterialIcon Kind="Delete" Classes="danger"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Classes="danger" Margin="0" Text="Radera"/>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </TableView.ContextMenu>
            <TableView.Columns>
                <TableViewColumn Header="Kursnummer" Binding="{Binding CourseNumber}"></TableViewColumn>
                <TableViewColumn Header="Title" Binding="{Binding Title}"></TableViewColumn>
                <TableViewColumn Header="Startdatum" Binding="{Binding StartDate}"></TableViewColumn>
                <TableViewColumn Header="Slutdatum" Binding="{Binding EndDate}"></TableViewColumn>
                <TableViewColumn Header="Kurstyp" Binding="{Binding CourseType }"></TableViewColumn>
            </TableView.Columns>
        </TableView>
        <Panel Grid.Row="0" Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowPopUp}">
            <!-- The dialog box, centered -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PopUpPrompt}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Danger}"
                                Content="Ja"
                                Command="{Binding DeleteCoursesCommand}"
                                CommandParameter="{Binding SelectedCourses}"
                        />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Secondary}"
                                Content="Avbryt"
                                Command="{Binding SetShowPopUpCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
        <Panel Grid.Row="0" Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowSpinner}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SpinnerText}"/>
                    <ProgressRing IsIndeterminate="True"></ProgressRing>
                    
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
