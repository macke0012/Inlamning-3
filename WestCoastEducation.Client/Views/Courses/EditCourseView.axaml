<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:courses="clr-namespace:WestCoastEducation.Client.ViewModels.Courses"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="courses:EditCourseViewModel"
             x:Class="WestCoastEducation.Client.Views.Courses.EditCourseView">
    <ScrollViewer Background="{DynamicResource Surface}">
        <Grid
            Background="{DynamicResource ElevatedSurface}" ColumnDefinitions="*,*" HorizontalAlignment="Stretch"
              Margin="20">

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="10">
                <StackPanel Classes="inputPanel">
                    <Label Content="Kurs typ"></Label>
                    <ComboBox ItemsSource="{Binding CourseTypes}" SelectedItem="{Binding CourseType}"></ComboBox>
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Kursnummer"></Label>
                    <TextBox Text="{Binding CourseNumber}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Titel"></Label>
                    <TextBox Text="{Binding Title}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Startdatum"></Label>
                    <DatePicker SelectedDate="{Binding StartDate}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Slutdatum"></Label>
                    <DatePicker SelectedDate="{Binding EndDate}" />
                </StackPanel>
                <StackPanel Classes="inputPanel" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding EditCourseCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10" Orientation="Horizontal">
                            <avalonia:MaterialIcon Kind="ContentSave" VerticalAlignment="Center" />
                            <TextBlock Text="Spara" VerticalAlignment="Center" Margin="0,4,0,0"></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10" Orientation="Horizontal">
                            <avalonia:MaterialIcon Kind="CloseCircleOutline"  VerticalAlignment="Center"/>
                            <TextBlock Text="Avbryt" VerticalAlignment="Center" Margin="0,4,0,0"></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>


            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="1"
                        IsVisible="{Binding IsClassroomCourse}">
                <StackPanel Classes="inputPanel">
                    <Label Content="Klassrum"></Label>
                    <TextBox Text="{Binding LectureHall}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Gata"></Label>
                    <TextBox Text="{Binding Street}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Postnummer"></Label>
                    <TextBox Text="{Binding ZipCode}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Stad"></Label>
                    <TextBox Text="{Binding Town}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Land"></Label>
                    <ComboBox
                        SelectedItem="{Binding Country}"
                        ItemsSource="{Binding Countries}">
                    </ComboBox>
                </StackPanel>
            </StackPanel>


            <StackPanel Margin="0,10" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="1"
                        IsVisible="{Binding IsRemoteCourse}">
                <StackPanel Classes="inputPanel">
                    <Label Content="Platform"></Label>
                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" />
                </StackPanel>
                <StackPanel Classes="inputPanel">
                    <Label Content="Länk"></Label>
                    <TextBox Text="{Binding MeetingLink}" />
                </StackPanel>
            </StackPanel>


        </Grid>
    </ScrollViewer>
</UserControl>