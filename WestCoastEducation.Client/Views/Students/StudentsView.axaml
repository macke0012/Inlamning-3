<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WestCoastEducation.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:teachers="clr-namespace:WestCoastEducation.Client.ViewModels.Students"
             x:DataType="teachers:StudentsViewModel"
             x:Class="WestCoastEducation.Client.Views.Students.StudentsView">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="5">
            <Button Content="Skapa student"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToAddStudentCommand}" />
            <Button Content="Generera 5 Studenter" Command="{Binding GenerateStudentCommand}"></Button>
        </StackPanel>
        <TableView Grid.Row="1" ItemsSource="{Binding Students}" 
                   SelectedItems="{Binding SelectedStudents}" 
                   SelectionMode="Multiple"
                   >
            <TableView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" Command="{Binding SetShowPopUpCommand}" CommandParameter="Är du säker på att du vill radera de valda studenterna?"></MenuItem>
                    <MenuItem IsEnabled="{Binding IsEditable}" Header="Edit" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToEditStudentCommand}" CommandParameter="{Binding SelectedStudents[0]}" ></MenuItem>
                </ContextMenu>
            </TableView.ContextMenu>
            <TableView.Columns>
                <TableViewColumn Header="Förnamn" Binding="{Binding FirstName}"></TableViewColumn>
                <TableViewColumn Header="Efternamn" Binding="{Binding LastName}"></TableViewColumn>
                <TableViewColumn Header="Telefon" Binding="{Binding PhoneNumber}"></TableViewColumn>
                <TableViewColumn Header="E-post" Binding="{Binding Email}"></TableViewColumn>
                <TableViewColumn Header="Personnummer" Binding="{Binding SSN}"></TableViewColumn>
                <TableViewColumn Header="Kurser" Binding="{Binding CoursesNames}"></TableViewColumn>
            </TableView.Columns>
        </TableView>
        <Panel Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowPopUp}">
            <!-- The dialog box, centered -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PopUpPrompt}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Danger}"
                                Content="Ja"
                                Command="{Binding DeleteStudentsCommand}"
                                CommandParameter="{Binding SelectedStudents}"
                        />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Secondary}"
                                Content="Avbryt"
                                Command="{Binding SetShowPopUpCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
        <Panel Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowSpinner}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SpinnerText}"/>
                    <ProgressRing IsIndeterminate="True"></ProgressRing>
                    
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>