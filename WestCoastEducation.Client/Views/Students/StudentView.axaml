<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:teachers="clr-namespace:WestCoastEducation.Client.ViewModels.Students"
             x:DataType="teachers:StudentViewModel"
             x:Class="WestCoastEducation.Client.Views.Students.StudentView">
    <TableView ItemsSource="{Binding Students}" Background="{DynamicResource ElevatedSurface}">
        <TableView.Columns>
            <TableViewColumn Header="Förnamn" Binding="{Binding FirstName}"></TableViewColumn>
            <TableViewColumn Header="Efternamn" Binding="{Binding LastName}"></TableViewColumn>
            <TableViewColumn Header="Telefon" Binding="{Binding PhoneNumber}"></TableViewColumn>
            <TableViewColumn Header="E-post" Binding="{Binding Email}"></TableViewColumn>
            <TableViewColumn Header="Personnummer" Binding="{Binding SSN}"></TableViewColumn>
            <TableViewColumn Header="Kurser" Binding="{Binding CoursesNames}"></TableViewColumn>
        </TableView.Columns>
    </TableView>
</UserControl>