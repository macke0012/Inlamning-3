<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:teachers="clr-namespace:WestCoastEducation.Client.ViewModels.Teachers"
             xmlns:vm="using:WestCoastEducation.Client.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="teachers:TeachersViewModel"
             x:Class="WestCoastEducation.Client.Views.Teachers.TeachersView">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="5">
            <Button
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToAddTeacherCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <avalonia:MaterialIcon Kind="AccountAdd" />
                    <TextBlock Text="Skapa lärare"></TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding GenerateTeacherCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <avalonia:MaterialIcon Kind="Magic" />
                    <TextBlock Text="Generera 5 lärare"></TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
        <TableView Grid.Row="1" SelectionMode="Multiple" ItemsSource="{Binding Teachers}"
                   SelectedItems="{Binding SelectedTeachers}">
            <TableView.ContextMenu>
                <ContextMenu>
                    <MenuItem IsEnabled="{Binding IsEditable}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateToEditTeacherCommand}"
                              CommandParameter="{Binding SelectedTeachers[0]}">
                        <MenuItem.Icon>
                            <avalonia:MaterialIcon Kind="AccountEdit"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Margin="0" Text="Redigera"/>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem  Command="{Binding SetShowPopUpCommand}"
                               CommandParameter="Är du säker på att du vill radera dessa lärare?">
                        <MenuItem.Icon>
                            <avalonia:MaterialIcon Kind="Delete" Classes="danger"/>
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock Classes="danger" Margin="0" Text="Radera"/>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </TableView.ContextMenu>

            <TableView.Columns>
                <TableViewColumn Header="Förnamn" Binding="{Binding FirstName}"></TableViewColumn>
                <TableViewColumn Header="Efternamn" Binding="{Binding LastName}"></TableViewColumn>
                <TableViewColumn Header="Telefon" Binding="{Binding PhoneNumber}"></TableViewColumn>
                <TableViewColumn Header="E-post" Binding="{Binding Email}"></TableViewColumn>
                <TableViewColumn Header="Personnummer" Binding="{Binding Ssn}"></TableViewColumn>
                <TableViewColumn Header="Kompetenser" Binding="{Binding KnowledgeArea}"></TableViewColumn>
            </TableView.Columns>
        </TableView>
        <Panel Grid.Row="0" Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowPopUp}">
            <!-- The dialog box, centered -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PopUpPrompt}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Danger}"
                                Content="Ja"
                                Command="{Binding DeleteTeachersCommand}"
                                CommandParameter="{Binding SelectedTeachers}" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Secondary}"
                                Content="Avbryt"
                                Command="{Binding SetShowPopUpCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
        <Panel Grid.Row="0" Grid.RowSpan="2"
               Background="{DynamicResource Overlay}"
               IsVisible="{Binding ShowSpinner}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SpinnerText}" />
                    <ProgressRing IsIndeterminate="True"></ProgressRing>

                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>