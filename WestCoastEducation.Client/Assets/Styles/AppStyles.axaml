<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"></Setter>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Background" Value="{DynamicResource Background}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"></Setter>
    </Style>
    <Style Selector="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"></Setter>
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Primary}"></Setter>
    </Style>
    <Style Selector="TableView">
        <Setter Property="Background" Value="{DynamicResource Surface}"></Setter>
    </Style>
    <Style Selector="TableViewRow">
        <Setter Property="ToolTip.Tip" Value="Högerklicka för att alternativ"/>
        <Setter Property="ToolTip.ShowDelay" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource ElevatedSurface}"></Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="StackPanel.inputPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Width" Value="300"></Setter>
    </Style>
    <Style Selector="StackPanel.inputPanel > DatePicker">
        <Setter Property="Height" Value="35"></Setter>
    </Style>
    <Style Selector="StackPanel.inputPanel > TextBox">
        <Setter Property="Height" Value="10"></Setter>
    </Style>
</Styles>
