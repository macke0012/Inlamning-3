<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Background}"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"></Setter>
    </Style>
    <Style Selector="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"></Setter>
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Primary}"></Setter>
    </Style>
    <Style Selector="TableView">
        <Setter Property="Background" Value="{DynamicResource Surface}"></Setter>
    </Style>
    <Style Selector="TableViewRow">
        <Setter Property="ToolTip.Tip" Value="Högerklicka för att alternativ"/>
        <Setter Property="ToolTip.ShowDelay" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource ElevatedSurface}"></Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    
</Styles>
